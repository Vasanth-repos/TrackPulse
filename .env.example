# FastAPI Backend Configuration
PROJECT_NAME="Adaptive ETA Reliability & Forecasting System"
API_V1_PREFIX="/api"
PORT=8000
DEBUG=True

# Reliability Model Weights (Must sum to 1.0)
WEIGHT_UNCERTAINTY=0.35
WEIGHT_ERROR_TREND=0.25
WEIGHT_REGIME=0.20
WEIGHT_FRESHNESS=0.10
WEIGHT_VARIABILITY=0.10

# Category Thresholds
RELIABILITY_HIGH_THRESHOLD=70.0
RELIABILITY_MEDIUM_THRESHOLD=40.0
